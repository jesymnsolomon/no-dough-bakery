<script type="text/javascript">
    $(document).ready(function () {
        var map;
        var autocomplete;
        var marker;

        // Initialize the map
        function initMap() {
            var mapOptions = {
                center: { lat: 25.276987, lng: 55.296249 },
                zoom: 15
            };
            map = new google.maps.Map(document.getElementById('map'), mapOptions);

            // Initialize the autocomplete
            var id = 'location';
            autocomplete = new google.maps.places.Autocomplete(document.getElementById(id), {
                types: ['geocode'],
            });

            // Add a listener for place changed event
            autocomplete.addListener('place_changed', function () {
                var place = autocomplete.getPlace();
                if (!place.geometry) {
                    return;
                }

                // Center the map on the selected place
                map.setCenter(place.geometry.location);

                // Set the marker on the selected place
                if (marker) {
                    marker.setMap(null);
                }
                marker = new google.maps.Marker({
                    map: map,
                    position: place.geometry.location,
                    draggable: true // Make the marker draggable
                });

                // Add listener for marker dragend event
                marker.addListener('dragend', function () {
                    var newPosition = marker.getPosition();
                    console.log('New Marker Position:', newPosition.toString());

                    // Update coordinates display
                    updateCoordinatesDisplay(newPosition.lat(), newPosition.lng());

                    // Reverse geocode to update input box location
                    reverseGeocode(newPosition);
                });

                // Update coordinates display based on searched location
                updateCoordinatesDisplay(place.geometry.location.lat(), place.geometry.location.lng());
            });

            // Add listener for button click to get live location
            document.getElementById('get-location').addEventListener('click', function () {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(function (position) {
                        var currentLocation = {
                            lat: position.coords.latitude,
                            lng: position.coords.longitude
                        };
                        map.setCenter(currentLocation);

                        if (marker) {
                            marker.setMap(null);
                        }
                        marker = new google.maps.Marker({
                            map: map,
                            position: currentLocation,
                            draggable: true
                        });

                        // Update input value to live location coordinates
                        updateCoordinatesDisplay(currentLocation.lat, currentLocation.lng);

                        // Add listener for marker dragend event to update coordinates display
                        marker.addListener('dragend', function () {
                            var newPosition = marker.getPosition();
                            console.log('New Marker Position:', newPosition.toString());

                            // Update coordinates display
                            updateCoordinatesDisplay(newPosition.lat(), newPosition.lng());

                            // Reverse geocode to update input box location
                            reverseGeocode(newPosition);
                        });

                        // Reverse geocode to update input box location
                        reverseGeocode(currentLocation);
                    });
                } else {
                    alert('Geolocation is not supported by this browser.');
                }
            });
        }

        // Initialize the map on page load
        initMap();

        // Function to update coordinates display
        function updateCoordinatesDisplay(latitude, longitude) {
            var coordinatesDisplay = document.getElementById('coordinates');
            coordinatesDisplay.value = formatCoordinates(latitude, longitude);
        }

        // Function to format coordinates
        function formatCoordinates(latitude, longitude) {
            var latStr = latitude.toFixed(7); // Format latitude to 7 decimal places
            var lngStr = longitude.toFixed(7); // Format longitude to 7 decimal places
            var mapUrl = 'https://www.google.com/maps/place/' + latStr + '+' + lngStr;
            return mapUrl;
        }

        function formatCoordinateValue(coordValue) {
            var degrees = Math.floor(coordValue);
            var minutes = Math.floor((coordValue - degrees) * 60);
            var seconds = ((coordValue - degrees - minutes / 60) * 3600).toFixed(2);
            return degrees + '° ' + minutes + '\' ' + seconds + '\'\'';
        }

        // Function to reverse geocode and update input box location
        function reverseGeocode(position) {
            var geocoder = new google.maps.Geocoder();
            geocoder.geocode({ 'location': position }, function (results, status) {
                if (status === google.maps.GeocoderStatus.OK) {
                    if (results[0]) {
                        document.getElementById('location').value = results[0].formatted_address;
                    } else {
                        console.log('No results found');
                    }
                } else {
                    console.log('Geocoder failed due to: ' + status);
                }
            });
        }
    });
</script>
