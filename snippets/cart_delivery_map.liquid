                subjectSel.onchange = function () {
                    chapterSel.length = 1; // empty Chapters dropdown
                    topicSel.length = 1; // empty Topics dropdown

                    // Display correct values for Topics
                    for (var y in subjectObject[this.value]) {
                        topicSel.options[topicSel.options.length] = new Option(y, y);
                    }
                }

                topicSel.onchange = function () {
                    chapterSel.length = 1; // empty Chapters dropdown

                    // Display correct values for Chapters
                    var z = subjectObject[subjectSel.value][this.value];
                    for (var i = 0; i < z.length; i++) {
                        chapterSel.options[chapterSel.options.length] = new Option(z[i], z[i]);
                    }
                    updateDeliveryGeoSearch();
                }
                function updateDeliveryGeoSearch() {
                    var topicValue = topicSel.value;
                    var deliveryGeoSearchField = document.getElementById("deliveryGeoSearchField");
                    var submitButton = document.querySelector('[aria-label="Submit Button"]');

                    if (deliveryGeoSearchField && topicValue) {
                        deliveryGeoSearchField.value = "";
                        setTimeout(function () {
                            deliveryGeoSearchField.dispatchEvent(new Event('input', { bubbles: true }));
                        }, 100);
                        setTimeout(function () {
                            let event = new KeyboardEvent('keydown', {
                                key: 'Enter',
                                bubbles: true
                            });
                            deliveryGeoSearchField.dispatchEvent(event);
                        }, 500);
                        deliveryGeoSearchField.value = topicValue;
                        setTimeout(function () {
                            submitButton.click();
                        }, 100);
                    } else {
                        console.error("Topic or deliveryGeoSearchField not found!");
                    }
                }

            }
        </script>


