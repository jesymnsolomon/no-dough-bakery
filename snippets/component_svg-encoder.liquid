{% comment %}
    Attributes

    - svg_code
    - alt
{% endcomment %}

{% if svg_code != blank %}
    {% assign encoded_svg = svg_code | replace: '<', '%3C' | replace: '>', '%3E' | replace: '#', '%23' | urlencode %}
    {% assign encoded_svg = 'data:image/svg+xml,' | append: encoded_svg %}

    {%- if url_only -%}
        {{- encoded_svg -}}
    {%- else -%}
        <img src='{{ encoded_svg }}' alt="{{ alt }}" loading="lazy">
    {%- endif -%}
{%- endif -%}