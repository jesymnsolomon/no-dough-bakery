{%- style -%}
  /* Full-width banner media without margins or padding */
  .banner__media {
    width: 100vw;
    margin: 0;
    padding: 0;
  }

  /* Centering content and customizing padding */
  #Banner-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: {{ section.settings.text_color }};
  }

  .banner__content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 80%;
  }

  /* Title and Text Styling for Desktop */
  .banner__heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size_desktop }}px;
    line-height: {{ section.settings.heading_line_height_desktop }}px;
    margin-bottom: {{ section.settings.heading_margin_bottom_desktop }}px;
  }

  .banner__text--primary {
    color: {{ section.settings.primary_text_color }};
    font-size: {{ section.settings.primary_text_font_size_desktop }}px;
    line-height: {{ section.settings.primary_text_line_height_desktop }}px;
    margin-bottom: {{ section.settings.primary_text_margin_bottom_desktop }}px;
  }

  .banner__text--secondary {
    color: {{ section.settings.secondary_text_color }};
    font-size: {{ section.settings.secondary_text_font_size_desktop }}px;
    line-height: {{ section.settings.secondary_text_line_height_desktop }}px;
    margin-bottom: {{ section.settings.secondary_text_margin_bottom_desktop }}px;
  }

  /* Button Styling */
  .button.button--primary {
    margin-top: 1em !important;
    padding: 0.75em 1.5em !important;
    border-radius: 150px !important;
    background-color: {{ section.settings.button_background_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
  }

  /* Responsive visibility and Mobile Adjustments */
  @media only screen and (min-width: 768px) {
    .mobile-only {
      display: none;
    }
  }

  @media only screen and (max-width: 767px) {
    .desktop-only {
      display: none;
    }

    .banner__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
      line-height: {{ section.settings.heading_line_height_mobile }}px;
      margin-bottom: {{ section.settings.heading_margin_bottom_mobile }}px;
    }

    .banner__text--primary {
      font-size: {{ section.settings.primary_text_font_size_mobile }}px;
      line-height: {{ section.settings.primary_text_line_height_mobile }}px;
      margin-bottom: {{ section.settings.primary_text_margin_bottom_mobile }}px;
    }

    .banner__text--secondary {
      font-size: {{ section.settings.secondary_text_font_size_mobile }}px;
      line-height: {{ section.settings.secondary_text_line_height_mobile }}px;
      margin-bottom: {{ section.settings.secondary_text_margin_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{%-liquid
  assign banner_height = section.settings.banner_height
%}

<div id="Banner-{{ section.id }}" class="banner section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient  {{ banner_height }}-size">

  <!-- Desktop Only Content -->
  <div class="desktop-only banner__media">
    <img src="{{ section.settings.desktop_image | image_url: width: 3840 }}"
         srcset="{{ section.settings.desktop_image | image_url: width: 375 }} 375w,
                 {{ section.settings.desktop_image | image_url: width: 550 }} 550w,
                 {{ section.settings.desktop_image | image_url: width: 750 }} 750w,
                 {{ section.settings.desktop_image | image_url: width: 1100 }} 1100w,
                 {{ section.settings.desktop_image | image_url: width: 1500 }} 1500w,
                 {{ section.settings.desktop_image | image_url: width: 1780 }} 1780w,
                 {{ section.settings.desktop_image | image_url: width: 2000 }} 2000w,
                 {{ section.settings.desktop_image | image_url: width: 3000 }} 3000w,
                 {{ section.settings.desktop_image | image_url: width: 3840 }} 3840w"
         sizes="100vw"
         alt="Desktop Hero Image"
         style="width: 100%;" />
    <div class="banner__content">
      <h2 class="banner__heading">{{ section.settings.heading }}</h2>
      <div class="banner__text--primary rte">{{ section.settings.primary_text }}</div>
      <div class="banner__text--secondary rte">{{ section.settings.secondary_text }}</div>
      <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_text }}</a>
    </div>
  </div>

  <!-- Mobile Only Content -->
  <div class="mobile-only banner__media">
    <img src="{{ section.settings.mobile_image | image_url: width: 3840 }}"
         srcset="{{ section.settings.mobile_image | image_url: width: 375 }} 375w,
                 {{ section.settings.mobile_image | image_url: width: 550 }} 550w,
                 {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
                 {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w,
                 {{ section.settings.mobile_image | image_url: width: 1500 }} 1500w,
                 {{ section.settings.mobile_image | image_url: width: 1780 }} 1780w,
                 {{ section.settings.mobile_image | image_url: width: 2000 }} 2000w,
                 {{ section.settings.mobile_image | image_url: width: 3000 }} 3000w,
                 {{ section.settings.mobile_image | image_url: width: 3840 }} 3840w"
         sizes="100vw"
         alt="Mobile Hero Image"
         style="width: 100%; height: auto;" />
    <div class="banner__content">
      <h2 class="banner__heading">{{ section.settings.heading }}</h2>
      <div class="banner__text--primary rte">{{ section.settings.primary_text }}</div>
      <div class="banner__text--secondary rte">{{ section.settings.secondary_text }}</div>
      <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_text }}</a>
    </div>
  </div>
</div>

